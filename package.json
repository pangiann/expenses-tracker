{
  "name": "expenses-tracker",
  "private": true,
  "type": "module",
  "description": "Personal expenses tracker: a website on Cloudflare, shared live within a household.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild web/scripts/main.tsx --bundle --format=esm --target=es2022 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --minify --sourcemap --outfile=web/dist/main.js",
    "watch": "npm run build -- --watch",
    "dev": "wrangler dev",
    "seed": "tsx scripts/seed-dev-data.mjs",
    "typecheck": "npm run types && tsc -p shared && tsc -p web && tsc -p worker && tsc -p test",
    "lint": "eslint .",
    "types": "wrangler types worker/worker-configuration.d.ts --env-file /dev/null > /dev/null",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "check": "npm run types && prettier --check . && eslint . && tsc -p shared && tsc -p web && tsc -p worker && tsc -p test && vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "jose": "^6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "wrangler": "^4.40.0"
  }
}
