{
  "name": "expenses-tracker",
  "private": true,
  "type": "module",
  "description": "Personal expenses tracker: a website on Cloudflare, shared live within a household.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild web/scripts/main.ts --bundle --format=esm --target=es2022 --sourcemap --outfile=web/dist/main.js",
    "watch": "npm run build -- --watch",
    "dev": "wrangler dev",
    "seed": "tsx scripts/seed-dev-data.mjs",
    "typecheck": "tsc -p shared && tsc -p web && tsc -p worker",
    "lint": "eslint .",
    "types": "wrangler types worker/worker-configuration.d.ts --env-file /dev/null",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "check": "prettier --check . && eslint . && npm run typecheck && vitest run"
  },
  "dependencies": {
    "jose": "^6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/sortablejs": "1.15.9",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "sortablejs": "1.15.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "wrangler": "^4.40.0"
  }
}
