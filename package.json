{
  "name": "expenses-tracker",
  "private": true,
  "type": "module",
  "description": "Personal expenses tracker: local Mac app or a shared Cloudflare deployment.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild web/scripts/main.js --bundle --format=esm --target=es2022 --sourcemap --outfile=web/dist/main.js",
    "watch": "npm run build -- --watch",
    "dev": "wrangler dev",
    "seed": "node --experimental-websocket scripts/seed-dev-data.mjs",
    "test": "node --test test/",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "sortablejs": "1.15.7",
    "wrangler": "^4.40.0"
  }
}
