{
  "name": "expenses-tracker",
  "private": true,
  "type": "module",
  "description": "Personal expenses tracker: a website on Cloudflare, shared live within a household.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild web/scripts/main.js --bundle --format=esm --target=es2022 --sourcemap --outfile=web/dist/main.js",
    "watch": "npm run build -- --watch",
    "dev": "wrangler dev",
    "seed": "node --experimental-websocket scripts/seed-dev-data.mjs",
    "typecheck": "tsc -p web && tsc -p worker",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "test": "node --test test/",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "sortablejs": "1.15.7",
    "typescript": "6.0.3",
    "wrangler": "^4.40.0"
  }
}
