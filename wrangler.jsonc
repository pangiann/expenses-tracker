{
  // Cloudflare deployment. Settings that identify people (Access team, emails) are
  // secrets set in the Cloudflare dashboard, never in this file. See README.md.
  "name": "expenses-tracker",
  "main": "worker/worker-entry-point.ts",
  // Bundles the page (web/scripts -> web/dist) before every `wrangler deploy` and `wrangler dev`.
  // `wrangler dev` builds again whenever a file in web/scripts changes.
  "build": { "command": "npm run build", "watch_dir": "web/scripts" },
  "compatibility_date": "2026-05-03",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
  },
  "durable_objects": {
    // "HouseholdRoom" is the name Cloudflare stores every household's months under. The code's
    // class is HouseholdDurableObject, exported under this name in worker/worker-entry-point.ts.
    // Changing this name needs a Durable Object rename migration, or the stored months are lost.
    "bindings": [{ "name": "HOUSEHOLD_DURABLE_OBJECTS", "class_name": "HouseholdRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HouseholdRoom"] }],
}
